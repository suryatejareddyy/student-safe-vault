# Supabase Project Configuration for Student Safe Vault
# Retrieve these values from your Supabase Project Settings > API
# URL: https://supabase.com/dashboard/project/_/settings/api

# The unique URL of your Supabase project instance (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The Public Anon/Publishable Key (safe to use in frontend client code)
# NEVER put your service_role secret key here!
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here
